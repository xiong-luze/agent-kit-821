# Copy to voice_duplex.env beside the executable; no cloud credentials belong here.
V821_FULL_DUPLEX=1
V821_WAKE_ENABLED=1
V821_WAKE_WORD='你好涂鸦'
V821_WAKE_MODEL=/mnt/UDISK/wake/tuya
V821_WAKE_DICTIONARY=/mnt/UDISK/wake/tuya/wake.dict
# Candidate tuned on the test board: human replay 3/3, known negatives 0/5.
V821_WAKE_THRESHOLD=1e-35
# Raw-mic activity qualification only; a phonetic KWS match is still required.
V821_WAKE_MIN_RMS=350
V821_WAKE_HOLD_MS=30000
V821_BARGE_MS=120
V821_PRE_ROLL_MS=600
V821_AEC_TAIL=300
V821_GUARD_MS=300
# Speex profile can use normal startup noise calibration.
# The current SDK-WebRTC/ADC180 candidate on the test board uses START=500, END=300.
# These are measured candidate values for this board; validate other hardware separately.
# V821_VAD_START=...
# V821_VAD_END=...
