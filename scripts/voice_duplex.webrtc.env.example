# V821 test-board profile; compile with ALSA + SDK WebRTC + PocketSphinx first.
# Copy beside the executable as voice_duplex.env and prepare matching resources.
# Thresholds/gain require new acoustic validation when changing board or enclosure.
V821_FULL_DUPLEX=1
V821_WAKE_ENABLED=1
V821_WAKE_WORD='你好涂鸦'
V821_WAKE_MODEL=./wake/tuya
V821_WAKE_DICTIONARY=./wake/tuya/wake.dict
V821_WAKE_THRESHOLD=1e-35
V821_WAKE_MIN_RMS=350
V821_WAKE_HOLD_MS=30000
V821_BARGE_MS=120
V821_PRE_ROLL_MS=600
V821_AEC_TAIL=300
V821_GUARD_MS=300
V821_VAD_START=500
V821_VAD_END=300
